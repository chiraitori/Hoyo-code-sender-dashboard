# Server-only secrets (set in Vercel Project Settings — NEVER prefix with PUBLIC_)
MAIN_BOT_API_URL=https://bot-api.example.com
AUTH_BOT_SECRET=replace-with-64-char-hex-secret-matching-vps-bot
VPS_EDGE_SECRET=optional-edge-secret-matching-vps
DISCORD_CLIENT_SECRET=replace-with-discord-oauth-client-secret

# Public values (NEXT_PUBLIC_* names are also accepted as fallback for smooth migration)
PUBLIC_DISCORD_CLIENT_ID=replace-with-discord-application-id
PUBLIC_APP_URL=https://your-dashboard.vercel.app
